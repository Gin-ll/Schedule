{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "schedule-desktop",
  "version": "0.1.0",
  "identifier": "com.schedule.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Schedule",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "widget",
        "title": "Desktop Widget",
        "url": "/widget",
        "width": 320,
        "height": 780,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "visible": false,
        "resizable": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
